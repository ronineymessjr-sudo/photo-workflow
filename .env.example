# PhotoAtelier V2 环境变量说明
# 前端的 Worker 地址与同步 Token 由“设置”页面保存在当前浏览器，不应写入仓库。

# Cloudflare Worker 非敏感变量（建议写入 worker/wrangler.toml 或 Dashboard）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_TABLE_PROJECTS=tblxxxxxxxxxxxxxxxx
FEISHU_TABLE_REFERENCES=tblxxxxxxxxxxxxxxxx
FEISHU_TABLE_PLANS=tblxxxxxxxxxxxxxxxx
FEISHU_TABLE_SHOTS=tblxxxxxxxxxxxxxxxx
FEISHU_TABLE_TASKS=tblxxxxxxxxxxxxxxxx
FEISHU_TABLE_LUTS=tblxxxxxxxxxxxxxxxx
FEISHU_TABLE_REVIEWS=tblxxxxxxxxxxxxxxxx
FEISHU_TABLE_MESSAGES=tblxxxxxxxxxxxxxxxx
ALLOWED_ORIGINS=http://127.0.0.1:8123,http://localhost:8123,https://photoatelier.pages.dev

# 必须通过 `wrangler secret put` 配置，禁止提交真实值
APP_SYNC_TOKEN=replace-with-random-sync-token
FEISHU_APP_SECRET=replace-with-feishu-app-secret
PEXELS_API_KEY=optional-pexels-key
AGENT_API_KEY=optional-agent-key
OBSIDIAN_BRIDGE_TOKEN=optional-private-bridge-token

# 可选服务地址
AGENT_ENDPOINT=https://your-agent.example/v1/generate
OBSIDIAN_BRIDGE_URL=https://your-private-bridge.example

# 每日知识代理。默认使用 OpenAI 多模态模型；将真实密钥仅写入本机 .env。
DAILY_KB_AGENT_PROVIDER=openai-vision
DAILY_KB_AGENT_BASE_URL=https://api.openai.com/v1
DAILY_KB_AGENT_MODEL=gpt-4.1-mini
DAILY_KB_AGENT_API_KEY=
