# PhotoAtelier 环境变量模板
# 复制为 .env 后填入真实值

# ============================================
# 后端 API 配置 (Cloudflare Workers)
# ============================================

# Worker 部署名称
WORKER_NAME=photoatelier-api

# JWT 密钥 (生成命令: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-here

# ============================================
# Supabase 配置
# ============================================

# Supabase 项目 URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase 匿名密钥 (Anon Key)
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase 服务密钥 (Service Role Key) - 仅服务端使用
SUPABASE_SERVICE_KEY=your-service-key-here

# ============================================
# AI 服务配置
# ============================================

# MiniMax API 密钥 (用于 AI 生成)
MINIMAX_API_KEY=your-minimax-api-key

# MiniMax 模型选择 (可选)
MINIMAX_MODEL=abab6.5s-chat

# Pollinations API (图片生成，无需密钥)
POLLINATIONS_API_URL=https://image.pollinations.ai

# ============================================
# 前端配置
# ============================================

# API 基础地址 (部署后填入 Worker 地址)
API_BASE_URL=https://your-worker.your-subdomain.workers.dev

# 应用环境 (development/production)
NODE_ENV=production

# ============================================
# 可选配置
# ============================================

# 请求超时时间 (毫秒)
API_TIMEOUT=30000

# 日志级别 (debug/info/warn/error)
LOG_LEVEL=info
