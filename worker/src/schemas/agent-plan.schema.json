{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "photoatelier.agent-plan.v1",
  "title": "PhotoAtelier Agent Plan",
  "type": "object",
  "required": ["concept", "visual_direction", "equipment", "shots", "tasks", "risks"],
  "properties": {
    "concept": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string" },
    "visual_direction": { "type": "object" },
    "equipment": { "type": "array", "items": { "type": "string" } },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sequence", "scene", "shot_size", "focal_length", "composition", "lighting", "pose", "priority"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "scene": { "type": "string" },
          "shot_size": { "type": "string" },
          "focal_length": { "type": "string" },
          "aperture": { "type": "string" },
          "shutter": { "type": "string" },
          "iso": { "type": ["integer", "string"] },
          "white_balance": { "type": "string" },
          "camera_angle": { "type": "string" },
          "composition": { "type": "string" },
          "lighting": { "type": "string" },
          "pose": { "type": "string" },
          "subject_action": { "type": "string" },
          "duration_minutes": { "type": "integer", "minimum": 1 },
          "priority": { "type": "string" },
          "fallback": { "type": "string" },
          "reference_ids": { "type": "array", "items": { "type": "string" } },
          "sources": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "tasks": { "type": "array", "items": { "type": "object" } },
    "lut_suggestion": { "type": ["object", "null"] },
    "risks": { "type": "array", "items": { "type": "string" } },
    "sources": { "type": "array", "items": { "type": "object" } }
  },
  "additionalProperties": false
}
