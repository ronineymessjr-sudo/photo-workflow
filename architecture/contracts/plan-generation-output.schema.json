{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "photoatelier.plan-generation-output.v3.1",
  "type": "object",
  "required": ["concept", "rationale", "preparationGuide", "expectedDeliverableCount", "shots", "risks"],
  "properties": {
    "concept": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string" },
    "visualDirection": { "type": "object" },
    "preparationGuide": { "type": "array", "items": { "type": "string" } },
    "expectedDeliverableCount": { "type": "integer", "minimum": 1 },
    "mustHaveShotCount": { "type": "integer", "minimum": 1 },
    "equipmentRecommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "source", "externalRequirement"],
        "properties": {
          "equipmentItemId": { "type": ["string", "null"] },
          "name": { "type": "string" },
          "role": { "type": "string" },
          "source": { "enum": ["assigned", "external"] },
          "externalRequirement": { "type": "boolean" },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sequence", "scene", "shotSize", "cameraAngle", "composition", "focalLength", "lighting", "poseGuidance", "variationCount", "targetSelectCount", "priority", "estimatedMinutes", "sourceTrace"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "scene": { "type": "string" },
          "shotSize": { "type": "string" },
          "cameraAngle": { "type": "string" },
          "composition": { "type": "string" },
          "focalLength": { "type": "string" },
          "lighting": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "properties": {
                  "main": { "type": "string" },
                  "direction": { "type": "string" },
                  "auxiliary": { "type": "string" },
                  "effect": { "type": "string" }
                },
                "required": ["main"],
                "additionalProperties": false
              }
            ]
          },
          "poseGuidance": { "type": "string" },
          "subjectAction": { "type": "string" },
          "variationCount": { "type": "integer", "minimum": 1 },
          "targetSelectCount": { "type": "integer", "minimum": 1 },
          "priority": { "enum": ["must", "recommended", "optional"] },
          "estimatedMinutes": { "type": "integer", "minimum": 1 },
          "fallback": { "type": "string" },
          "emotion": { "type": "string", "description": "Shot emotion keyword" },
          "mood": { "type": "string", "description": "Shot mood description" },
          "referenceAssetId": { "type": ["string", "null"], "description": "Primary reference image bound to this shot" },
          "learningFocus": { "type": "string", "description": "What to learn from the reference image" },
          "whyThisShot": { "type": "string", "description": "Why this shot was designed" },
          "visualMatchScore": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Reference image match score 0-100" },
          "sourceTrace": {
            "type": "object",
            "properties": {
              "referenceAssetIds": { "type": "array", "items": { "type": "string" } },
              "equipmentItemIds": { "type": "array", "items": { "type": "string" } },
              "templateId": { "type": ["string", "null"] }
            },
            "required": ["referenceAssetIds", "equipmentItemIds"],
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    },
    "expectedLook": {
      "type": ["object", "null"],
      "properties": {
        "enabled": { "type": "boolean" },
        "realReferenceAssetIds": { "type": "array", "items": { "type": "string" } },
        "colorIntent": { "type": "string" },
        "lightingIntent": { "type": "string" },
        "retouchIntent": { "type": "string" },
        "lutIntent": { "type": "string" }
      },
      "required": ["enabled"],
      "additionalProperties": false
    },
    "risks": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
